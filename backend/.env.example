# Sablonul variabilelor de mediu ale backend-ului. ACEST fisier se comite; `backend/.env` NU (e gitignorat).
#
# DE CE doua fisiere: aici stau NUMELE variabilelor, ca oricine cloneaza proiectul sa stie ce are de completat;
# valorile reale (chei) stau doar in `.env`, pe calculatorul fiecaruia, sau in dashboard-ul gazdei in productie.
#
# Setup: cp .env.example .env  ->  completeaza valorile  ->  reporneste `./mvnw spring-boot:run`.
# Aplicatia citeste `.env` singura la pornire (daca rulezi din folderul `backend/`). Fara ghilimele in valori.

# Cheia OpenAI. Exista DOAR aici, in backend. Fara ea aplicatia porneste, iar consilierul raspunde 503.
OPENAI_API_KEY=your_openai_api_key

# Modelul OpenAI folosit de consilier (o singura valoare, fara selector). Vezi docs/openai/README.md.
CPA_LLM_MODEL=gpt-5-mini

# Originile browserului care au voie sa apeleze API-ul, separate prin virgula; niciodata `*`.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Baza de date: implicit H2 in memorie (nu e nevoie de nimic local). In productie (Render + Neon) se activeaza profilul
# `prod`, care CERE urmatoarele trei variabile; valorile reale stau doar in dashboard-ul Render. Vezi docs/neon/README.md.
# Formatul URL-ului este JDBC (nu `postgresql://...` din consola Neon), iar utilizatorul si parola sunt separate:
#   jdbc:postgresql://<host-neon>/<baza>?sslmode=require
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
