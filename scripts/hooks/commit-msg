#!/bin/sh
# Enforces the format `CPA-<issue number> <message>` on the first line of the commit message
# (rules live in scripts/check-naming.sh; see AGENTS.md §4).
# Activation: git config core.hooksPath scripts/hooks

first_line=$(head -n 1 "$1")

exec sh "$(dirname "$0")/../check-naming.sh" message "$first_line"
