    "/api/v1/vehicles" : {
      "get" : {
        "description" : "Filters are optional and combined with AND. Vehicles are ordered by make and model, variants by price. Prices are indicative; `dataAsOf` is the date the figures are valid for.",
        "operationId" : "search",
        "parameters" : [ {
          "in" : "query",
          "name" : "bodyType",
