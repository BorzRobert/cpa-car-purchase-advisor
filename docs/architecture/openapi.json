  "info" : {
    "description" : "REST API of the Car Purchase Advisor. All data comes from deterministic services; the advisor only explains it.",
    "title" : "CPA Backend API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/conversations" : {
      "get" : {
        "description" : "Most recently updated first. The number of conversations per session is capped.",
        "operationId" : "list_1",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/Conversation"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List conversations",
        "tags" : [ "Conversations" ]
      },
      "post" : {
        "description" : "The title is optional; if empty it is derived from the first message.",
        "operationId" : "create_1",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateConversationRequest"
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Conversation"
                }
              }
            },
            "description" : "Created"
          }
        },
        "summary" : "Create a conversation",
        "tags" : [ "Conversations" ]
      }
    },
    "/api/v1/conversations/{conversationId}/messages" : {
      "get" : {
        "description" : "Oldest first. The number of messages per conversation is capped.",
        "operationId" : "list_2",
        "parameters" : [ {
          "in" : "path",
          "name" : "conversationId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/Message"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List messages",
        "tags" : [ "Messages" ]
      },
      "post" : {
        "description" : "Stores the user message, then streams the answer as Server-Sent Events (`text/event-stream`):\n`meta` {messageId, conversationId}, then `token` {delta} repeatedly, interleaved with the advisor's tool\nactivity (`tool` {name, status: started|finished, summary}, `vehicles` {cards, dataAsOf}, `profile` {patch},\n`compare` {vehicles, criteria, scores, assumptions, dataAsOf}),\nthen `done` {usage: {input, output}}; `error` (same shape as a problem response) replaces `done` when the\nanswer fails after the stream began.\nA comment line is sent every ~15 s as a heartbeat. Everything that can be checked up front (401, 404,\n400, 409, 429, 503) is a regular `application/problem+json` response before the stream starts.\nCall it with `fetch` and read the body as a stream; `EventSource` cannot send POST or headers.\n",
        "operationId" : "post",
        "parameters" : [ {
          "in" : "path",
          "name" : "conversationId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PostMessageRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "The event stream."
          }
        },
        "summary" : "Send a message and stream the advisor's answer",
        "tags" : [ "Messages" ]
      }
    },
